# Env vars for api/submit-case.js — set these in the Vercel project, never commit values.
# Names only; see the header comment of api/submit-case.js for details.

# Required: fine-grained PAT (Contents + Pull requests, read/write) for the showcase PR flow
GITHUB_TOKEN=

# Cloudflare Turnstile secret — bot verification (function is fail-closed without it)
TURNSTILE_SECRET=

# Optional overrides (defaults: btekmen / memexlab / main)
GH_OWNER=
GH_REPO=
GH_BASE=

# Dev-only escape hatch: "true" skips Turnstile verification
ALLOW_UNVERIFIED=
